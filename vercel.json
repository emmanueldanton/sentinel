{
  "version": 2,
  "buildCommand": "cd sentinel/frontend && rm -rf node_modules && npm install && npx vite build",
  "outputDirectory": "sentinel/frontend/dist",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sentinel/api/:path*", "destination": "/api/index" },
    { "source": "/sentinel/auth/:path*", "destination": "/api/index" },
    { "source": "/sentinel/health", "destination": "/api/index" },
    { "source": "/sentinel/assets/:path*", "destination": "/sentinel/assets/:path*" },
    { "source": "/sentinel", "destination": "/index.html" },
    { "source": "/sentinel/", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
